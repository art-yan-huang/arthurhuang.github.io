<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Arthur Huang - Personal Website</title>
  <style>
    :root {
      --font-main: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      --text-color: #222222;
      --link-color: #0366d6;
      --award-color: #b33a00;
      --bg-color: #ffffff;
      --max-width: 820px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 40px 20px;
      font-family: var(--font-main);
      color: var(--text-color);
      background-color: var(--bg-color);
      line-height: 1.6;
    }

    .container {
      max-width: var(--max-width);
      margin: 0 auto;
    }

    /* Header Profile */
    .header-section {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      gap: 32px;
      margin-bottom: 30px;
    }

    .header-text {
      flex: 1;
    }

    .header-text h1 {
      margin-top: 0;
      margin-bottom: 6px;
      font-size: 2.2rem;
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    .header-text .subtitle {
      font-size: 1.1rem;
      color: #555555;
      margin-bottom: 16px;
    }

    .profile-photo {
      width: 170px;
      height: 220px;
      object-fit: cover;
      border-radius: 4px;
      border: 1px solid #e1e4e8;
      background-color: #f6f8fa;
    }

    /* Navigation Jump Links */
    .nav-links {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      margin: 24px 0 36px 0;
      padding: 10px 0;
      border-top: 1px solid #eaecef;
      border-bottom: 1px solid #eaecef;
      list-style: none;
    }

    .nav-links a {
      color: var(--link-color);
      text-decoration: none;
      font-weight: 500;
      font-size: 0.95rem;
    }

    .nav-links a:hover {
      text-decoration: underline;
    }

    /* Headings */
    h2 {
      font-size: 1.4rem;
      border-bottom: 1px solid #eaecef;
      padding-bottom: 6px;
      margin-top: 40px;
      margin-bottom: 16px;
    }

    h3.year-heading {
      font-size: 1.1rem;
      color: #666666;
      margin-top: 24px;
      margin-bottom: 12px;
      font-weight: 600;
    }

    p {
      margin: 0 0 14px 0;
    }

    a {
      color: var(--link-color);
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    /* Highlight Banner */
    .highlight-box {
      background-color: #fff9f5;
      border-left: 4px solid var(--award-color);
      padding: 12px 16px;
      margin: 20px 0;
      font-size: 0.95rem;
    }

    .highlight-box strong {
      color: var(--award-color);
    }

    /* Publication Entries */
    .pub-entry {
      margin-bottom: 20px;
    }

    .pub-title {
      font-weight: 600;
      color: #111111;
      display: block;
    }

    .pub-authors {
      font-size: 0.95rem;
      color: #333333;
    }

    .pub-venue {
      font-size: 0.92rem;
      font-style: italic;
      color: #555555;
    }

    .pub-award {
      color: var(--award-color);
      font-weight: 600;
      font-size: 0.9rem;
      margin-top: 2px;
    }

    .pub-links {
      font-size: 0.88rem;
      margin-top: 4px;
    }

    .pub-links a {
      margin-right: 10px;
      font-weight: 500;
    }

    /* Lists */
    ul {
      margin: 0 0 16px 0;
      padding-left: 20px;
    }

    li {
      margin-bottom: 8px;
    }

    /* Footer */
    footer {
      margin-top: 60px;
      padding-top: 20px;
      border-top: 1px solid #eaecef;
      font-size: 0.85rem;
      color: #6a737d;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
    }

    @media (max-width: 600px) {
      .header-section {
        flex-direction: column-reverse;
        align-items: center;
        text-align: center;
      }
      .profile-photo {
        width: 140px;
        height: 180px;
      }
    }
  </style>
</head>
